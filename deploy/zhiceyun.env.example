# 智测云 systemd 环境变量
# 安装到 /etc/zhiceyun/zhiceyun.env，权限 600 root:zhiceyun

NODE_ENV=production

# MySQL 连接串。密码含特殊字符时必须做 URL 编码。
DATABASE_URL=mysql://zhiceyun:请替换为数据库密码@127.0.0.1:3306/zhiceyun

# 大模型接口
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 学生访问的公网地址，例如 Cloudflare 隧道的域名
PUBLIC_BASE_URL=https://quiz.example.com
# 通过 HTTPS 访问必须为 true
COOKIE_SECURE=true