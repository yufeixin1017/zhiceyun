# Docker Compose 部署环境变量
# 复制为 .env 后填写，.env 已被 .gitignore 忽略。

# 数据库密码：请使用字母和数字组合，避免 @ : / ? # 等会破坏 URL 的字符
MYSQL_ROOT_PASSWORD=请替换为root强密码
MYSQL_PASSWORD=请替换为应用数据库密码
MYSQL_USER=zhiceyun

# 大模型接口（与本地 .env.local 相同）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 学生访问的公网地址，例如 Cloudflare 隧道地址；留空则自动使用局域网地址
PUBLIC_BASE_URL=
# 通过 HTTPS 访问时必须为 true；仅 HTTP 内网调试时改为 false
COOKIE_SECURE=true