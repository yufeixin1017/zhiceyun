# OpenAI-compatible chat completions API.
# The app uses the clearly labelled built-in demo generator when AI_API_KEY is empty.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# Optional: used to build the public quiz URL shown by the teacher dashboard.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
