# OpenAI-compatible chat completions API.
# The app uses the clearly labelled built-in demo generator when AI_API_KEY is empty.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# MySQL 8.x. URL-encode special characters in the database password.
DATABASE_URL=mysql://zhiceyun:replace_with_password@127.0.0.1:3306/zhiceyun

# Secure cookies for HTTPS deployments. Local `next start` over HTTP may use false.
COOKIE_SECURE=true

# Optional: the public origin students should use (LAN IP, tunnel or domain).
# When empty the app falls back to the address the teacher is currently using,
# then to the first LAN IPv4 address.
# PUBLIC_BASE_URL=https://quiz.example.com
